#include <stdio.h>

struct Sensor
{
    int id;
    float temperature;
    float humidity;
    float voltage;
    float current;
};

void displayValue(struct Sensor s)
{
    printf("\n--- Sensor Details (call by Value) ---");
    printf("\nSensor ID: %d", s.id);
    printf("\nTemperature: %.2f C", s.temperature);
    printf("\nHumidity : %.2f %%", s.humidity);
    printf("\nVoltage : %.2f V", s.voltage);
    printf("\nCurrent : %.2f A\n", s.current);
}

void displayReference(struct Sensor *s)
{
    printf("\n--- Sensor Details (call by reference)---");
    printf("\nSensor ID : %d", s->id);
    printf("\nTemperature: %.2f C", s->temperature);
    printf("\nHumidity : %.2f %%", s->humidity);
    printf("\nVoltage : %.2f V", s->voltage);
    printf("\nCurrent : %.2f A\n", s->current);
}

int main()
{
    int n, i;
    printf("Enter number of sensors :");
    scanf("%d", &n);

    struct Sensor sensor[n];
    struct Sensor *ptr = sensor;

    for (i = 0; i < n; i++)
    {
        printf("\nEnter details of sensor %d\n", i + 1);
        printf("Sensor ID :");
        scanf("%d", &(ptr + i)->id);
        printf("Temperature :");
        scanf("%f", &(ptr + i)->temperature);
        printf("Humidity :");
        scanf("%f", &(ptr + i)->humidity);
        printf("Voltage :");
        scanf("%f", &(ptr + i)->voltage);
        printf("Current :");
        scanf("%f", &(ptr + i)->current);
    }

    printf("\n\nDisplaying Sensor Records");
    for (i = 0; i < n; i++)
    {
        displayValue(*(ptr + i));
        displayReference(ptr + i);
    }

    return 0;
}
