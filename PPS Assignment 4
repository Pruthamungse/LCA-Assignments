#include <stdio.h>

int main()
{
    int A[2][3], B[2][3];
    int sum[2][3], diff[2][3];
    int i, j;
    printf("Enter first matrix elements :\n");
    for (i = 0; i < 2; i++)
        for (j = 0; j < 3; j++)
            scanf("%d", &A[i][j]);
    printf("Enter second matrix elements :\n");
    for (i = 0; i < 2; i++)
        for (j = 0; j < 3; j++)
            scanf("%d", &B[i][j]);
    for (i = 0; i < 2; i++)
        for (j = 0; j < 3; j++)
        {
            sum[i][j] = A[i][j] + B[i][j];
            diff[i][j] = A[i][j] - B[i][j];
        }
    printf("Addition of two matrices :\n");
    for (i = 0; i < 2; i++)
    {
        for (j = 0; j < 3; j++)
            printf("%d ", sum[i][j]);
        printf("\n");
    }
    printf("Subtraction of two matrices :\n");
    for (i = 0; i < 2; i++)
    {
        for (j = 0; j < 3; j++)
            printf("%d ", diff[i][j]);
        printf("\n");
    }
    return 0;
}
