#include <stdio.h>

long factorial_recursive(int n)
{
    if (n == 0 || n == 1)
    {
        return 1;
    }
    return n * factorial_recursive(n - 1);
}

long long factorial_iterative(int n)
{
    long long fact = 1;
    for (int i = 1; i <= n; i++)
    {
        fact *= i;
    }
    return fact;
}

int main()
{
    int n;
    printf("Enter any input no:");
    scanf("%d", &n);
    printf("Factorial of number (Recursive): %ld\n", factorial_recursive(n));
    printf("Factorial of number (Iterative): %lld\n", factorial_iterative(n));
    return 0;
}
